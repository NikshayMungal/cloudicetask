# Copy to `.env` and adjust:   cp .env.example .env
# `.env` is git-ignored. NEVER commit real passwords, connection strings or tokens.
# Every value below is a dummy placeholder.

# ---------- Local database container (docker compose) ----------
POSTGRES_USER=logistics
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=logistics
DB_PORT=5432

# ---------- Backend (ASP.NET Core API) ----------
ASPNETCORE_ENVIRONMENT=Development
# Comma-separated browser origins allowed to call the API (CORS).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Insert sample shipments when the table is empty (set to false in production).
SEED_DEMO_DATA=true
BACKEND_PORT=5000

# Production only (hosted Neon/Supabase). Not used by docker compose, which builds its own
# connection string from the POSTGRES_* values above. Set this in your hosting dashboard.
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ---------- Frontend (React + nginx) ----------
FRONTEND_PORT=3000
# Leave EMPTY locally (nginx proxies /api to the backend).
# In production set to the backend's public URL, e.g. https://logistics-api.onrender.com
API_BASE_URL=
